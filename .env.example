# App
APP_ENV=development
COMPANY_EMAIL_DOMAIN=domain.com

# Postgres
POSTGRES_USER=db_user
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=db_ai_agent

MCP_DB_USER=mcp_readonly
MCP_DB_PASSWORD=change-me-locally

# Redis
REDIS_URL=redis://redis:6379/0

# JWT auth
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=60

# AI
MCP_SERVER_URL=http://mcp-server:8000/mcp
ANTHROPIC_API_KEY=key

OLLAMA_URL=http://ollama:11434
OLLAMA_URL_LOCAL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Storage
REPORTS_DIR=/app/storage/reports
CV_STORAGE_DIR=/app/storage/cv
POLICY_STORAGE_DIR=/app/storage/policies